{
    "version": 1,
    "project": "rgsaddle",
    "project_url": "https://github.com/OmniPotentRPC/rgsaddle",
    "repo": ".",
    "branches": ["main"],
    "show_commit_url": "https://github.com/OmniPotentRPC/rgsaddle/commit/",
    "environment_type": "virtualenv",
    "pythons": ["3.12"],
    "launch_method": "spawn",
    "install_timeout": 3600,
    "default_benchmark_timeout": 600,
    "build_cache_size": 2,
    "matrix": {
        "req": {
            "numpy": ["2.5.4"],
            "asv_bench_memray": ["0.1.2"],
            "memray": ["1.20.0"]
        }
    },
    "build_command": [
        "CMAKE_BUILD_PARALLEL_LEVEL=4 CARGO_BUILD_JOBS=4 python -m pip install asv-runner==0.3.2 build==1.6.1 cmake==4.4.4 nanobind==3.1.0 ninja==1.13.2 numpy==2.5.4 scikit-build-core==1.1.1",
        "CMAKE_BUILD_PARALLEL_LEVEL=4 CARGO_BUILD_JOBS=4 python -m build --wheel --no-isolation -o {build_cache_dir} {build_dir} --config-setting=cmake.build-type=Release --config-setting=build-dir={build_cache_dir}/cmake",
        "python {conf_dir}/benchflow/record_options.py {build_cache_dir}/cmake {build_cache_dir}/buildtype.txt"
    ],
    "install_command": [
        "in-dir={env_dir} python -m pip install {wheel_file}"
    ],
    "uninstall_command": [
        "return-code=any python -m pip uninstall -y {project}"
    ],
    "benchmark_dir": "benchmarks",
    "env_dir": ".asv/env",
    "results_dir": ".asv/results",
    "html_dir": ".asv/html"
}
